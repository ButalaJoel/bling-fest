# Copy to server/.env and fill in. NEVER commit server/.env.

PORT=4000
NODE_ENV=development

# Render Postgres -> your database -> "Internal Database URL" (on Render) or
# "External Database URL" (from your PC). Add ?sslmode=require for the external one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blingfest

# Signs the login cookie. Must be long and random (64+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Image storage (cloudinary.com -> Dashboard -> API Keys). Required in production.
# In development, leaving these empty stores photos in server/.uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First owner account, used once by `npm run seed`. Delete the password after seeding.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional bot protection on the vendor form: Cloudflare Turnstile (free).
# dash.cloudflare.com -> Turnstile -> Add site (your domain + bling-fest.onrender.com).
# Set BOTH or NEITHER. Leave empty to keep it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
